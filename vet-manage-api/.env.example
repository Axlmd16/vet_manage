# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

PORT=3080
API_PREFIX=api/v1
DATABASE_URL="postgresql://vetmanage:vetmanage_dev_password@localhost:55432/vet_manage?schema=public"
REDIS_URL="redis://localhost:56379"
RABBITMQ_URL="amqp://vetmanage:vetmanage_dev_password@localhost:55672"
JWT_SECRET="vetmanage-dev-jwt-secret-change-me-0123456789"
JWT_EXPIRES_IN=15m
RBAC_SYNC_MODE=strict
ADMIN_EMAIL=admin@vetmanage.local
ADMIN_PASSWORD=Admin12345
ADMIN_IDENTIFICATION=1700000001
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Inicial
